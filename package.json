{
  "name": "timeline-pptx-export",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:embed": "tsc -b && vite build --base=/tools/timeline-pptx-export/ && rm -f dist/aicoo_logo.svg",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:export": "jiti scripts/checkExportCoverage.ts",
    "check:design": "jiti scripts/checkDesignSystem.ts",
    "check:scale": "jiti scripts/checkTimeScale.ts",
    "check:colors": "jiti scripts/checkColorParity.ts",
    "check:csv": "jiti scripts/checkCsvRoundTrip.ts",
    "check:dates": "jiti scripts/checkDateCommit.ts"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.436.0",
    "marked": "^18.0.9",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jiti": "^2.7.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
